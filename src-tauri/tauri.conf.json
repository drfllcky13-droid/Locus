{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locus",
  "version": "0.1.0",
  "identifier": "app.locus.desktop",
  "build": {
    "beforeDevCommand": "pnpm -C app dev",
    "beforeBuildCommand": "pnpm -C app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [{ "title": "Locus", "width": 1400, "height": 900, "minWidth": 800, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
