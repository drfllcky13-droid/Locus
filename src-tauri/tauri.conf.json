{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lotus",
  "version": "0.1.0",
  "identifier": "io.github.drfllcky13-droid.lotus",
  "build": {
    "beforeDevCommand": "pnpm -C app dev",
    "beforeBuildCommand": "pnpm -C app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lotus",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "additionalBrowserArgs": "--force_high_performance_gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost locus: http://locus.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../THIRD_PARTY_NOTICES.txt"
    ]
  }
}
